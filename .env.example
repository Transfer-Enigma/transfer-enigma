DOCKER_PROD_IMAGES_TAG="latest-stable"

ENVIRONMENT="dev"
DISABLE_ADMIN_AUTH_CHECK=false
LOG_LEVEL="INFO"

DB_USER="<your db user name>"
DB_PASS="<your db user pass>"
DB_NAME="<your db name>"
DB_HOST="<your db host>"
DB_PORT="<your db port>"
DB_SCHEME="mysql+aiomysql"
DB_COLLATE="utf8mb4_unicode_ci"
DB_LOG_LEVEL="WARNING"
DB_LOG_OUTPUT="both"

ADMIN_LOGIN="<admin login>"
ADMIN_PASSWORD="<admin password>"
JWT_ALGORITHM="HS256"
AUTHJWT_SECRET_KEY="<secret key>"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=4320

APP_PORT=80
ADMINER_PORT=8080
ADMIN_FRONT_PORT=3000
FRONTEND_PORT=5173

FESCO_API_KEY=

REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=0

DEFAULT_GSHEETS_URL="<URL>"
DEFAULT_SEA_ROUTES_WS="SEA"
DEFAULT_RAIL_ROUTES_WS="RAIL"
DEFAULT_TRUCK_ROUTES_WS="TRUCK"
DEFAULT_DROPP_ROUTES_WS="DROPP"
DEFAULT_POINTS_WS="POINTS"
DEFAULT_SERVICES_WS="SERVICES"
